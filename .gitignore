# Ignore everything by default.
*

# Keep directories traversable so allowed files can be discovered.
!*/

# Track only source code and explicitly supported text/documentation formats.
!.gitignore
!AGENTS.md
!*.md
!requirements*.txt
!*.py
!*.json
!*.jsonl

# Python caches and generated bytecode.
.venv/
__pycache__/
*.py[cod]
*$py.class

# TIFF images.
*.tif
*.tiff

# Checkpoints and model weights.
checkpoints/
checkpoint/
checkpoint-*/
weights/
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.h5
*.hdf5
*.pb
*.pkl
*.pickle
*.joblib
*.npz
*.jsonl

# Per-run artifacts are intentionally local. Each run contains its own frozen
# config and metadata, but those files must not be picked up by the global JSON
# exception above.
runs/

# Dataset derivati locali (manifest JSON incluso).
main/data/Salinas_LUD/
