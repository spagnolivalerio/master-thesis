{
  "_comment": [
    "data: EuroSAT MS, split stratificato e normalizzazione per banda",
    "model: encoder piu ampi e un banco di basi spettrali per ciascuna classe",
    "encoder_training: MSE di ricostruzione, batch bilanciati; resume=false avvia una nuova run",
    "monitor: RMC reali/ricostruite e basi salvate a ogni epoca",
    "simplex: ILR con statistiche distinte per classe stimate sul training set",
    "ddpm_model: U-Net condizionale piu ampia nello spazio ILR",
    "ddpm_training: MSE sul rumore, EMA; resume=false avvia una nuova run",
    "evaluation: sampling per classe e confronto RMC sul test set",
    "paths: checkpoint e log indipendenti; immagini e risultati solo sotto outputs/"
  ],
  "experiment": {
    "name": "latent_unmixing_per_class_large",
    "seed": 42
  },
  "data": {
    "root": "data/EuroSAT_MS",
    "image_size": 64,
    "channels": 13,
    "num_classes": 10,
    "split": {
      "train": 0.9,
      "validation": 0.05,
      "test": 0.05
    },
    "normalization_max": 10000,
    "rgb_display_max": 0.3,
    "statistics_batch_size": 64,
    "band_names": [
      "B1",
      "B2",
      "B3",
      "B4",
      "B5",
      "B6",
      "B7",
      "B8",
      "B9",
      "B10",
      "B11",
      "B12",
      "B8A"
    ],
    "wavelengths_nm": [
      443,
      490,
      560,
      665,
      705,
      740,
      783,
      842,
      945,
      1375,
      1610,
      2190,
      865
    ]
  },
  "model": {
    "num_bases": 12,
    "hidden_channels": 128,
    "num_res_blocks": 4,
    "norm_num_groups": 8,
    "abundance_temperature": 1.0
  },
  "encoder_training": {
    "epochs": 30,
    "batch_size": 20,
    "validation_batch_size": 40,
    "encoder_learning_rate": 0.001,
    "basis_learning_rate": 0.001,
    "weight_decay": 0.0001,
    "max_grad_norm": 1.0,
    "num_workers": 4,
    "mixed_precision": "fp16",
    "pin_memory": true,
    "resume": true
  },
  "monitor": {
    "batch_size": 40,
    "axis_margin": 0.1
  },
  "simplex": {
    "epsilon": 1e-06,
    "statistics_epsilon": 0.0001
  },
  "ddpm_model": {
    "base_channels": 256,
    "channel_multipliers": [
      1,
      2,
      2
    ],
    "num_res_blocks": 2,
    "dropout": 0.0,
    "attention_head_dim": 8,
    "norm_num_groups": 32,
    "resnet_time_scale_shift": "scale_shift"
  },
  "diffusion": {
    "timesteps": 1000,
    "beta_schedule": "squaredcos_cap_v2",
    "prediction_type": "epsilon",
    "clip_sample": false
  },
  "cfg": {
    "condition_dropout": 0.1,
    "guidance_scale": 3.0
  },
  "ddpm_training": {
    "epochs": 100,
    "batch_size": 10,
    "validation_batch_size": 20,
    "gradient_accumulation_steps": 3,
    "learning_rate": 0.0001,
    "warmup_steps": 500,
    "max_grad_norm": 1.0,
    "ema_decay": 0.9999,
    "num_workers": 1,
    "mixed_precision": "fp16",
    "gradient_checkpointing": true,
    "pin_memory": true,
    "preview_inference_steps": 50,
    "resume": true
  },
  "evaluation": {
    "images_per_class": 100,
    "batch_size": 8,
    "inference_steps": 50
  },
  "paths": {
    "encoder_checkpoints": "experiments/latent_unmixing_per_class_large/encoder_checkpoints",
    "encoder_logs": "experiments/latent_unmixing_per_class_large/log/encoder",
    "encoder_previews": "outputs/previews/latent_unmixing_per_class_large_encoder",
    "ddpm_checkpoints": "experiments/latent_unmixing_per_class_large/ddpm_checkpoints",
    "ddpm_logs": "experiments/latent_unmixing_per_class_large/log/ddpm",
    "ddpm_previews": "outputs/previews/latent_unmixing_per_class_large_ddpm",
    "results": "outputs/results/latent_unmixing_per_class_large"
  }
}
